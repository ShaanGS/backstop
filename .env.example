# ─── Agent model ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Stripe (read: MRR, renewal, failed payments) ─────────────────────────────
# Test mode only. Keel refuses to seed with a live key.
STRIPE_SECRET_KEY=sk_test_...

# ─── Linear (read: support tickets · write: recovery task) ────────────────────
# Settings → Security & access → Personal API keys
LINEAR_API_KEY=lin_api_...

# ─── Slack (write: account-owner alert) ───────────────────────────────────────
# Create an app at api.slack.com/apps, add the chat:write bot scope, install to
# your workspace, then invite the bot to the channel with /invite @Keel
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0XXXXXXXXX

# ─── Notion (write: save-plan document) ───────────────────────────────────────
# notion.so/my-integrations → internal integration, then share a page with it.
# The parent page id is the 32-char hex in that page's URL.
NOTION_API_KEY=ntn_...
NOTION_PARENT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Resend (write: customer email) ───────────────────────────────────────────
RESEND_API_KEY=re_...
# Without a verified domain Resend only delivers to your own account address.
# RESEND_TO_OVERRIDE redirects every customer email there and preserves the
# intended recipient in the subject and headers. Keep it set outside production.
RESEND_TO_OVERRIDE=you@example.com
# RESEND_FROM="Keel <onboarding@resend.dev>"

# ─── Safety ───────────────────────────────────────────────────────────────────
# KEEL_DRY_RUN=1   # trace the full pipeline without performing any write

# ─── Telemetry (optional) ─────────────────────────────────────────────────────
# Token counts and per-phase latency are always recorded. A dollar figure is
# not: model list prices change, and a sourceless number on a dashboard is
# worse than no number. Set both to your own current rates to turn spend on.
# KEEL_PRICE_INPUT_PER_MTOK=0
# KEEL_PRICE_OUTPUT_PER_MTOK=0
